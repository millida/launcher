{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Millida Launcher",
  "version": "1.0.0",
  "identifier": "net.millida.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Millida Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:",
          "asset:",
          "http://asset.localhost"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "https:"
        ],
        "connect-src": [
          "'self'",
          "data:",
          "blob:",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "https://api.millida.net",
          "https://api.modrinth.com",
          "https://cdn.modrinth.com",
          "https://mc-heads.net"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-src": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'",
          "'unsafe-eval'",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "font-src": [
          "'self'",
          "data:",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:",
          "asset:",
          "http://asset.localhost",
          "http://127.0.0.1:5173"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "http://127.0.0.1:5173",
          "https:"
        ],
        "connect-src": [
          "'self'",
          "data:",
          "blob:",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "ws://127.0.0.1:5173",
          "ws://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "https://api.millida.net",
          "https://api.modrinth.com",
          "https://cdn.modrinth.com",
          "https://mc-heads.net"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "Millida",
    "homepage": "https://millida.net/launcher",
    "copyright": "© 2026 Millida (MARKET LINK LLC)",
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "Лаунчер Minecraft от Millida: версии от Mojang, загрузчики Fabric, Quilt, Forge и NeoForge, моды и модпаки с Modrinth и CurseForge.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "millida"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://launcher-storage.millida.net/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQUI2NEEwQjYwMUZFM0MKUldROC9nRzJvR1NyejZ5M0Z6UmpaaVRWb2F6cDI2VlJOTVN6OGZLRlhMWEZCa21VYUlMb3Erdi8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
